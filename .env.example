# Accident Detection & Alert System Configuration

# Emergency contact phone number for WhatsApp alerts (with country code, e.g. +91XXXXXXXXXX)
ALERT_PHONE_NUMBER=+919876543210

# Confidence threshold (0-100) required to trigger emergency alert
ACCIDENT_THRESHOLD=95.0

# Enable or disable automated WhatsApp alerts (True / False)
ENABLE_WHATSAPP_ALERT=True

# Enable or disable audio siren alert (True / False)
ENABLE_SOUND_ALERT=True

# Default video source (0 for webcam, or path to video/gif file)
DEFAULT_VIDEO_SOURCE=test1.gif
